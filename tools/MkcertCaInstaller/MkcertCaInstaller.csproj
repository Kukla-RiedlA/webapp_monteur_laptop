<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MkcertCaInstaller</RootNamespace>
    <AssemblyName>MkcertCaInstaller</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Lädt mkcert rootCA.pem vom Server und installiert sie im Windows-ROOT-Store (certutil).</Description>
  </PropertyGroup>
</Project>
