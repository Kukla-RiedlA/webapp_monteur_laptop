{
  "name": "monteur-webapp",
  "version": "1.0.33",
  "description": "Monteur WebApp – Offline-fähige Windows-App (Electron) mit lokaler SQLite-DB",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test:parameter-pdf": "node scripts/test-parameter-pdf.js",
    "test:parameter-pdf:open": "node scripts/test-parameter-pdf.js --open"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^3.11.174"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "sharp": "^0.33.5",
    "docx2pdf-converter": "^2.1.1",
    "docxtemplater": "^3.50.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.6",
    "sql.js": "^1.10.0",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "de.kukla.monteur-webapp",
    "productName": "Monteur WebApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "lib/**",
      "montagebericht_docx.js",
      "version.json",
      "db/**",
      "public/**",
      "templates/**"
    ],
    "asarUnpack": [
      "**/node_modules/docx2pdf-converter/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
