{
  "name": "monteur-webapp",
  "version": "1.4.26",
  "description": "Monteur WebApp – Offline-fähige Windows-App (Electron) mit lokaler SQLite-DB",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "generate-icons": "node scripts/generate-icons.js",
    "predist": "node scripts/generate-icons.js",
    "dist": "electron-builder --win",
    "test:parameter-pdf": "node scripts/test-parameter-pdf.js",
    "test:parameter-pdf:open": "node scripts/test-parameter-pdf.js --open"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^5.6.205"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "docx": "^9.6.1",
    "docx2pdf-converter": "^2.1.1",
    "docxtemplater": "^3.50.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.6",
    "sharp": "^0.33.5",
    "sql.js": "^1.10.0",
    "ws": "^8.14.2"
  },
  "build": {
    "appId": "de.kukla.monteur-webapp",
    "productName": "Monteur WebApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "lib/**",
      "lib/laptop-updater.js",
      "montagebericht_docx.js",
      "version.json",
      "db/schema.sql",
      "public/**",
      "templates/**"
    ],
    "asarUnpack": [
      "**/node_modules/docx2pdf-converter/**"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://update.local.invalid/api/laptop_release_feed.php/"
    },
    "artifactName": "Monteur-WebApp-Setup-${version}.${ext}",
    "icon": "public/icon.png",
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    }
  }
}
